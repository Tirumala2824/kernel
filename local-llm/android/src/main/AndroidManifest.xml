<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- No permissions. Models are either a user-picked .litertlm copied into
         app-specific storage through the Storage Access Framework, or a file
         that model-hub installed in the app's own storage. No storage and no
         network permission are needed here. -->
    <application>
        <!-- Optional vendor GPU libraries for the LiteRT-LM GPU backend.
             required="false": on phones without them the engine falls back
             to the CPU backend. -->
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <uses-native-library android:name="libvndksupport.so" android:required="false" />
        <!-- Qualcomm FastRPC (Hexagon DSP/NPU) client library, for SoC-specific
             LiteRT-LM builds. required="false": optional on every phone. -->
        <uses-native-library android:name="libcdsprpc.so" android:required="false" />
    </application>
</manifest>
