<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Core flows make zero network calls (docs/guardrails.md section 7).
         Strip INTERNET if any library (for example ML Kit's usage-logging
         transport) declares it, so release builds cannot reach the network.
         Debug builds keep it for the Flutter tool only (src/debug). -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
</manifest>
